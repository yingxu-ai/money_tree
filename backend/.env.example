DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL（无缝切换：改下面一行；本机或 docker compose --profile pg）
# DATABASE_URL=postgresql+asyncpg://postgres:postgresql@127.0.0.1:5432/industrial_ai
# 详细步骤见仓库 docs/database-switch.md

SECRET_KEY=dev-secret-change-in-production
DEBUG=true
SQL_ECHO=false
LOG_LEVEL=INFO

# 品牌展示（前端启动默认值，可被配置中心 SYSTEM 级覆盖）
APP_TITLE=工业 AI 应用基座
APP_SUBTITLE=通用技术底座 · Base Template
APP_SIDEBAR_TITLE=工业 AI 基座
APP_LOGO_URL=
APP_THEME=light

# 可选主题: light | dark（Gentelella）

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# 微信小程序（自动生成「车间厂码」小程序码；配一次即可）
# AppID 须与开发者工具里打开的小程序一致（含 gongshi-miniprogram 子包）
# Secret：微信公众平台 → 开发管理 → 开发设置 → AppSecret（重置后复制）
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
# 厂码落地页（一般不用改）
# WECHAT_MP_FACTORY_PAGE=gongshi-miniprogram/pages/gate/index
